# Secrets and stored credentials -- never commit these
.env
.env.*
!.env.example
.tokens.json
.tokens.json.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Tooling
.vercel
.DS_Store
.idea/
.vscode/

.vercel
.env*

# Export archives: their contents belong in the tree, the archive does not.
# One was committed into frontend/ and served publicly at /app/.
*.zip

# Test coverage artifacts
.coverage
htmlcov/

# Obsidian vault. The vault root is the REPO root, not docs/, so that the
# Obsidian Git plugin sees a git repo at the vault root -- its README does
# not promise support for a vault nested inside a repo, and an unverified
# setting is not something to build a sync on.
# The settings we agree on are committed; per-machine UI state is not.
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/*/data.json
