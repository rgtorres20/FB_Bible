# Copy to .env and fill in. Never commit the real .env.

# --- Yahoo app credentials (developer.yahoo.com/apps) ---------------------
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the Redirect URI on the Yahoo app EXACTLY. Yahoo requires https.
YAHOO_REDIRECT_URI=https://localhost:8000/auth/yahoo/callback
YAHOO_SCOPE=fspt-r

# --- Leagues (blueprint: Sunday Gravy 192426, The Trenches 811739) --------
# "nfl" resolves to the current season, so these survive the season rollover.
LEAGUE_KEYS=["nfl.l.192426","nfl.l.811739"]

# --- Token storage --------------------------------------------------------
# file  -> local dev
# redis -> serverless (Vercel has no writable disk between invocations)
TOKEN_STORE=file
TOKEN_FILE_PATH=.tokens.json
REDIS_URL=

# Required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- App ------------------------------------------------------------------
# Signs the OAuth state parameter. Use a long random string in production.
SESSION_SECRET=dev-only-change-me
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# --- Scheduled feed sync ---------------------------------------------------
# Shared secret for POST /internal/sync. Empty disables scheduled sync.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=
# Where polled news is stored when TOKEN_STORE=file (redis uses Redis).
FEED_FILE_PATH=data/feeds.json
